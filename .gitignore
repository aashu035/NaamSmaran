# ──────────────────────────────────────────────
# Naam Smaran — .gitignore
# ──────────────────────────────────────────────

# ── IDE & Editor ──────────────────────────────
.idea/
.cursor/
.vscode/
.continue/
*.iml
*.swp
*~

# ── Android / Gradle ─────────────────────────
.gradle/
.gradle-user-home/
build/
*/build/
captures/
local.properties
*.hprof

# ── Build Artifacts ──────────────────────────
*.apk
*.aab
*.aar
*.ap_
apk/

# ── Signing ──────────────────────────────────
*.jks
*.keystore
*.p12
google-services.json

# ── Kotlin / JVM ─────────────────────────────
.kotlin/
.localappdata/

# ── Node (v0/v1 legacy) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
dist/

# ── Environment & Secrets ────────────────────
.env
.env.*
!.env.example

# ── OS Artifacts ─────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Large Media (local-only) ─────────────────
# Video frames (~3GB), rendered videos, raw assets.
# These live on local disk and OneDrive, not in git.
frames/
videos/
Assets/

# The unanchored "Assets/" rule above also matches (case-insensitively on Windows)
# the native app's src/main/assets/. Re-include that one directory so
# sant_smaran.json is tracked, then re-exclude the saint photos below.
!v2-native-kotlin/app/src/main/assets/

# Saint photos for "प्रातः संत नाम स्मरण" — screenshots from another app,
# personal devotional use only. Never commit to this public repo.
# (sant_smaran.json, names only, stays tracked; missing photos fall back to name-cards.)
v2-native-kotlin/app/src/main/assets/saints/

# ── Development Notes (local-only) ───────────
# Planning docs, AI architecture exports, implementation notes.
# These are workspace artifacts, not source code.
*.pdf
implementation_plan.md
ralph-tasks.md
review.md

# ── Misc ─────────────────────────────────────
.android/
.git_archived/
.coderabbit.yaml
naam_smaran/
*.log
*.tmp
