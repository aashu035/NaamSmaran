# ──────────────────────────────────────────────
# Naam Smaran — .gitignore
# ──────────────────────────────────────────────

# ── IDE & Editor ──────────────────────────────
.idea/
.cursor/
.vscode/
*.iml
*.swp
*~

# ── Android / Gradle ─────────────────────────
.gradle/
.gradle-user-home/
build/
*/build/
captures/
local.properties
*.hprof

# ── Build Artifacts ──────────────────────────
*.apk
*.aab
*.aar
*.ap_
apk/

# ── Signing ──────────────────────────────────
*.jks
*.keystore
*.p12
google-services.json

# ── Kotlin / JVM ─────────────────────────────
.kotlin/
.localappdata/

# ── Node (v0/v1 legacy) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
dist/

# ── Environment & Secrets ────────────────────
.env
.env.*
!.env.example

# ── OS Artifacts ─────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Large Media (local-only) ─────────────────
# Video frames (~3GB), rendered videos, raw assets.
# These live on local disk and OneDrive, not in git.
frames/
videos/
Assets/

# ── Development Notes (local-only) ───────────
# Planning docs, AI architecture exports, implementation notes.
# These are workspace artifacts, not source code.
*.pdf
implementation_plan.md
ralph-tasks.md
review.md

# ── Misc ─────────────────────────────────────
.android/
.git_archived/
.coderabbit.yaml
naam_smaran/
*.log
*.tmp
